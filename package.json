{
  "name": "lumina-weddings",
  "private": true,
  "scripts": {
    "predev": "kill-port 3000 5173 5174",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start"
  },
  "dependencies": {
    "sequelizer": "^1.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1"
  }
}
