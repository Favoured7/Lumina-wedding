# Local development: Vite on :5173, API on :3000
VITE_API_URL=http://localhost:3000

# Production build served by the same Node server as the API: leave unset, or set empty:
# VITE_API_URL=

# Production: frontend on Netlify, API elsewhere — set full API origin:
# VITE_API_URL=https://your-api.up.railway.app
