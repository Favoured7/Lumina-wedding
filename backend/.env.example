PORT=3000
# Comma-separated browser origins allowed to call the API (CORS). For one site: your public https URL
CLIENT_ORIGIN=http://localhost:5173,https://localhost:5173
JWT_SECRET=change-this-super-secret
DATABASE_URL=sqlite:./lumina.sqlite
LUMINA_PLATFORM_FEE_PERCENT=0.2
NODE_ENV=development
# Optional; default 0.0.0.0 so the app is reachable on the network / in Docker
# HOST=0.0.0.0

GMAIL_USER=luminalove.com@gmail.com
GMAIL_APP_PASSWORD=
LUMINA_CONTACT_NOTIFY_EMAIL=luminalove.com@gmail.com
